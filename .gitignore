# ─────────────────────────────────────────────────────────────────────────────
# MockFlow AI — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Environment & secrets — NEVER commit these ────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
**/.env
**/.env.*
!**/.env.example

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.output/
**/dist/
**/build/

# ── Vite ──────────────────────────────────────────────────────────────────────
*.local
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ── Test & coverage ───────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Cache directories ─────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.prettiercache
**/.cache/

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor & IDE ──────────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ── Runtime & temp ────────────────────────────────────────────────────────────
pids/
*.pid
*.pid.lock
*.seed
*.tgz
tmp/
temp/
.tmp/
.temp/

# ── Package manager lock files (keep package-lock.json, ignore the rest) ──────
yarn.lock
pnpm-lock.yaml

# ── MongoDB local data (if running locally via Docker or native) ──────────────
data/db/
*.mongodb

# ── Backend specific ──────────────────────────────────────────────────────────
backend/.env
backend/.env.*
!backend/.env.example
backend/logs/
backend/tmp/

# ── Frontend specific ─────────────────────────────────────────────────────────
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/.vite/

# ── Kiro IDE ──────────────────────────────────────────────────────────────────
.kiro/hooks/
